name: Build LexJuridica IA

on:
  push:
    tags:
      - 'v*'          # se activa al crear un tag: git tag v1.0.0 && git push --tags
  workflow_dispatch:  # también se puede ejecutar manualmente desde GitHub

jobs:
  build-windows:
    runs-on: windows-latest
    steps:
      - name: Checkout código
        uses: actions/checkout@v4

      - name: Instalar Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'

      - name: Instalar dependencias
        run: npm ci

      - name: Construir instalador Windows
        run: npm run electron:build:win
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Subir artefactos Windows
        uses: actions/upload-artifact@v4
        with:
          name: LexJuridica-Windows
          path: |
            release/*.exe
            release/*.msi
          if-no-files-found: warn

  build-mac:
    runs-on: macos-latest
    steps:
      - name: Checkout código
        uses: actions/checkout@v4

      - name: Instalar Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'

      - name: Instalar dependencias
        run: npm ci

      - name: Construir DMG para Mac
        run: npm run electron:build:mac
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          # Sin firma de código (gratis, mostrará advertencia en Mac)
          CSC_IDENTITY_AUTO_DISCOVERY: false

      - name: Subir artefactos Mac
        uses: actions/upload-artifact@v4
        with:
          name: LexJuridica-Mac
          path: |
            release/*.dmg
            release/*.zip
          if-no-files-found: warn

  build-linux:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout código
        uses: actions/checkout@v4

      - name: Instalar Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: 'npm'

      - name: Instalar dependencias
        run: npm ci

      - name: Construir AppImage Linux
        run: npm run electron:build:linux
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Subir artefactos Linux
        uses: actions/upload-artifact@v4
        with:
          name: LexJuridica-Linux
          path: |
            release/*.AppImage
            release/*.deb
          if-no-files-found: warn

  # Job opcional: crear un Release en GitHub con todos los instaladores
  create-release:
    needs: [build-windows, build-mac, build-linux]
    runs-on: ubuntu-latest
    if: startsWith(github.ref, 'refs/tags/')
    steps:
      - name: Descargar artefactos Windows
        uses: actions/download-artifact@v4
        with:
          name: LexJuridica-Windows
          path: release/

      - name: Descargar artefactos Mac
        uses: actions/download-artifact@v4
        with:
          name: LexJuridica-Mac
          path: release/

      - name: Descargar artefactos Linux
        uses: actions/download-artifact@v4
        with:
          name: LexJuridica-Linux
          path: release/

      - name: Crear Release en GitHub
        uses: softprops/action-gh-release@v2
        with:
          files: release/*
          body: |
            ## LexJurídica IA ${{ github.ref_name }}
            
            Sistema de Inteligencia Jurídica Colombiana
            
            ### Descargas
            - **Windows**: `.exe` (instalador) 
            - **Mac**: `.dmg` (imagen de disco)
            - **Linux**: `.AppImage` o `.deb`
            
            ### Requisitos
            - Necesitas una API Key de Anthropic para el asistente IA
            - Obtén tu clave en: https://console.anthropic.com
            
            > ⚠️ Información con fines académicos. Siempre verifica en fuentes oficiales.
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
